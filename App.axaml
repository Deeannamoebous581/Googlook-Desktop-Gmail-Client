<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Googlook.Views"
             xmlns:ctl="using:Googlook.Controls"
             x:Class="Googlook.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Semantic colour tokens. Referenced with {DynamicResource ...} so they
           re-resolve instantly when the theme variant flips between Light and Dark. -->
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Surface"       Color="#F6F8FC"/>
          <SolidColorBrush x:Key="Panel"         Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PanelAlt"      Color="#F1F3F4"/>
          <SolidColorBrush x:Key="Search"        Color="#EAF1FB"/>
          <SolidColorBrush x:Key="Divider"       Color="#E8EAED"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#5F6368"/>
          <SolidColorBrush x:Key="TextMuted"     Color="#80868B"/>
          <SolidColorBrush x:Key="Blue"          Color="#1A73E8"/>
          <SolidColorBrush x:Key="ComposeBg"     Color="#C2E7FF"/>
          <SolidColorBrush x:Key="ComposeFg"     Color="#001D35"/>
          <SolidColorBrush x:Key="BannerBg"      Color="#FEF7E0"/>
          <SolidColorBrush x:Key="ChipBorder"    Color="#DADCE0"/>
          <SolidColorBrush x:Key="BadgeBg"       Color="#E8F0FE"/>
          <SolidColorBrush x:Key="AccentText"    Color="#C5221F"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Surface"       Color="#17181C"/>
          <SolidColorBrush x:Key="Panel"         Color="#202024"/>
          <SolidColorBrush x:Key="PanelAlt"      Color="#2A2A30"/>
          <SolidColorBrush x:Key="Search"        Color="#2A2A30"/>
          <SolidColorBrush x:Key="Divider"       Color="#34343A"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#A8ABB2"/>
          <SolidColorBrush x:Key="TextMuted"     Color="#8E9299"/>
          <SolidColorBrush x:Key="Blue"          Color="#8AB4F8"/>
          <SolidColorBrush x:Key="ComposeBg"     Color="#00497A"/>
          <SolidColorBrush x:Key="ComposeFg"     Color="#D3E3FD"/>
          <SolidColorBrush x:Key="BannerBg"      Color="#33301F"/>
          <SolidColorBrush x:Key="ChipBorder"    Color="#45454C"/>
          <SolidColorBrush x:Key="BadgeBg"       Color="#26343F"/>
          <SolidColorBrush x:Key="AccentText"    Color="#F28B82"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Base look: embedded Roboto (the Gmail typeface) at Gmail's 14px body size -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="FontFamily" Value="avares://Googlook/Assets/Fonts#Roboto, Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Top service-tab strip: transparent items, subtle hover -->
    <Style Selector="ListBox.tabstrip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.tabstrip ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}"/>
    </Style>

    <!-- Message rows: comfortable Gmail density -->
    <Style Selector="ListBox.messages ListBoxItem">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="MinHeight" Value="64"/>
    </Style>

    <!-- ============ Motion (deliberately conservative) ============
         Only opacity keyframes + brush transitions: both are safe at runtime.
         Transform-string keyframe animations are avoided on purpose — they are
         the class of Avalonia animation that fails at runtime, not compile time.
         Note the WebView2/terminal areas are native windows and ignore opacity;
         the surrounding chrome is what fades. -->

    <!-- Smooth hover/press: every button-ish control and list row -->
    <Style Selector=":is(Button) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>

    <!-- Service-tab switches: the incoming view fades in -->
    <Style Selector="views|MailView[IsVisible=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ctl|BrowserTab[IsVisible=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="views|TerminalView[IsVisible=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Lock overlay eases in rather than snapping -->
    <Style Selector="Border.lockOverlay[IsVisible=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.22" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- "Remote content blocked" banner fades in with its message -->
    <Style Selector="Border.fadeIn[IsVisible=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.25" FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>
</Application>
