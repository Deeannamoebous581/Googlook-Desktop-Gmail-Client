<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Googlook.Views.DrivePickerWindow"
        x:CompileBindings="False"
        Width="580" Height="620" Title="Attach from Google Drive"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Panel}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" x:Name="SearchBox" Watermark="Search your Drive…" KeyDown="OnSearchKey"/>
      <Button Grid.Column="1" Content="Search" Click="OnSearch" Margin="8,0,0,0" Padding="16,8"/>
    </Grid>

    <Border Grid.Row="1" Margin="0,10" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8">
      <ListBox x:Name="FilesList" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4">
              <TextBlock Grid.Column="0" Text="📄" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
      <ProgressBar Grid.Column="0" x:Name="Busy" IsIndeterminate="True" Width="130"
                   IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"/>
      <TextBlock Grid.Column="1" x:Name="Err" Foreground="{DynamicResource AccentText}" FontSize="12"
                 VerticalAlignment="Center" Margin="10,0"/>
      <Button Grid.Column="2" Content="Cancel" Padding="18,8" Click="OnCancel"/>
      <Button Grid.Column="3" Content="Attach" Padding="22,8" Margin="10,0,0,0"
              Background="{DynamicResource ComposeBg}" Click="OnAttach"/>
    </Grid>
  </Grid>
</Window>
